{
  "workflow_name": "Macro Video Studio",
  "version": "1.0.0",
  "source_attribution": {
    "repository": "https://github.com/ai-playbooks/nursery_rhyme_music_video",
    "relationship": "independent macro adaptation"
  },
  "project": {
    "theme": "user_defined",
    "duration_seconds": 3600,
    "aspect_ratio": "16:9",
    "resolution": "1920x1080",
    "nominal_clip_seconds": 10,
    "nominal_clip_count": 360,
    "chapters": 6,
    "visual_style": "photorealistic cinematic extreme macro",
    "mood": "contemplative"
  },
  "tools": {
    "image": "Artistly",
    "video": "VideoExpress",
    "voice": "CloneVoice (optional)",
    "soundtrack": "licensed ambient music",
    "capabilities_verified": true,
    "capability_verification_scope": "Interactive browser tests only; not API integration or proof of deterministic frame adherence.",
    "verified_workflow_features": [
      "Create Video From Prompt",
      "Advanced Mode with manual 10-second length",
      "1920x1080 landscape output",
      "Save Last Frame from Media Library",
      "select saved endpoint from My AI Images for next prompt"
    ]
  },
  "automation": {
    "mode": "sequential_browser_assisted_generation",
    "require_go_before_paid_generation": false,
    "proof_of_concept_clips": 5,
    "desired_batch_size": 1,
    "batch_size_requires_verification": false,
    "max_retries_per_scene": 1,
    "checkpoint_after_each_batch": true,
    "generation_policy": {
      "use_existing_membership_credits": true,
      "require_explicit_authorization_for_credit_purchase_or_upgrade": true,
      "generate_missing_stills_only": true,
      "video_route": "VideoExpress Create Video From Prompt",
      "advanced_mode": true,
      "manual_video_length_seconds": 10,
      "chain_via_editor_saved_last_frame": true,
      "preflight_gate": "verify selected reference thumbnail against source endpoint, replace sample text in both prompt fields, and verify aspect ratio, image type and duration before each render",
      "retry_rule": "one targeted retry after diagnosing a specific defect; never repeat an unchanged prompt",
      "save_endpoint_action": "Media Library > My Videos > clip context menu > Save Last Frame > verify My AI Images; avoids seeking the timeline boundary",
      "batch_size": 1
    }
  },
  "transitions": {
    "preferred": "editor_saved_last_frame_reference",
    "last_frame_reuse_requires_verification": true,
    "preserve": [
      "lighting direction",
      "focal plane",
      "palette",
      "subject geometry",
      "camera motion"
    ],
    "next_clip_adherence": "BB-002 retained violet droplet palette but orchid identity was unclear; visually inspect start and endpoint on each render"
  },
  "quality_control": {
    "check_photorealism": true,
    "check_continuity": true,
    "check_audio_rights": true,
    "check_timeline_duration": true,
    "check_export": true
  },
  "stages": [
    "intake",
    "visual_bible",
    "scene_plan",
    "prompt_book",
    "membership_allowance_check",
    "sequential_generation_checkpoint",
    "pilot_generation",
    "pilot_review",
    "batch_generation",
    "assembly",
    "audio",
    "qa",
    "export",
    "delivery"
  ]
}
